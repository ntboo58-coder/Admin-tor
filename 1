/* ══════════════════════════════════════════════════════════
   LOGIN ADMIN PANEL SCRIPT
   ══════════════════════════════════════════════════════════ */
(function(){
'use strict';

var DB_URL = "https://test-795b1-default-rtdb.firebaseio.com";
var allUsers = {};
var currentEditKey = null;
var currentChatUser = null;
var typingTimeout = null;
var mediaRecorder = null;
var audioChunks = [];
var isRecording = false;

function esc(x){
  return String(x == null ? '' : x).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'})[c]);
}
function timeAgo(ts){
  const diff = Math.floor((Date.now() - ts) / 1000);
  if (diff < 60) return diff + 's ago';
  if (diff < 3600) return Math.floor(diff/60) + 'm ago';
  if (diff < 86400) return Math.floor(diff/3600) + 'h ago';
  return Math.floor(diff/86400) + 'd ago';
}
function dbReq(path, method, body){
  return fetch(DB_URL + path + ".json", {
    method: method || "GET",
    headers: { "Content-Type": "application/json" },
    body: body === null || body === undefined ? undefined : JSON.stringify(body)
  }).then(function(r){
    return r.json().catch(function(){ return null; }).then(function(data){
      if (!r.ok) throw new Error((data && data.error) || ("DB request failed (" + r.status + ")"));
      if (data && typeof data === "object" && data.error) throw new Error(data.error);
      return data;
    });
  });
}

function startUsersListener(){
  fetchAll();
  setInterval(fetchAll, 4000);
}
var lastHash = '';
function fetchAll(){
  dbReq('/users', 'GET', null).then(function(raw){
    allUsers = (raw && typeof raw === 'object') ? raw : {};
    var h = JSON.stringify(Object.keys(allUsers).sort());
    updateStats();
    if (h !== lastHash){ lastHash = h; renderUsers(); }
    else renderUsers();
  }).catch(function(e){ console.log('users fetch failed:', e); });
}

function updateStats(){
  let total = 0, active = 0, expired = 0, banned = 0;
  const now = Date.now();
  for (const key in allUsers){
    total++;
    const u = allUsers[key];
    if (u.isBanned){ banned++; continue; }
    const exp = new Date(u.expiryDate).getTime();
    if (!u.expiryDate || isNaN(exp) || exp < now) expired++;
    else active++;
  }
  var e1 = document.getElementById('statTotal'); if (e1){ e1.textContent = total; }
  var e2 = document.getElementById('statActive'); if (e2){ e2.textContent = active; }
  var e3 = document.getElementById('statExpired'); if (e3){ e3.textContent = expired; }
  var e4 = document.getElementById('statBanned'); if (e4){ e4.textContent = banned; }
}

window.renderUsers = function(){
  var si = document.getElementById('searchInput');
  if (!si) return;
  const q = si.value.trim().toLowerCase();
  const list = document.getElementById('usersList');
  if (!list) return;
  const now = Date.now();
  const keys = Object.keys(allUsers).filter(k => !q || k.toLowerCase().includes(q));
  if (keys.length === 0){
    list.innerHTML = '<div class="login-empty-state"><i class="fa-solid fa-inbox"></i><div>No users found</div></div>';
    return;
  }
  keys.sort((a,b) => (allUsers[b].createdAt||0) - (allUsers[a].createdAt||0));
  let html = '';
  for (const key of keys){
    const u = allUsers[key];
    const exp = new Date(u.expiryDate).getTime();
    const isExp = !u.expiryDate || isNaN(exp) || exp < now;
    let status = 'active', statusText = 'ACTIVE';
    if (u.isBanned){ status = 'banned'; statusText = 'BANNED'; }
    else if (isExp){ status = 'expired'; statusText = 'EXPIRED'; }
    const devices = u.devices || {};
    const deviceCount = Object.keys(devices).length;
    const deviceLimit = Number(u.deviceLimit) || 1;
    const expDate = u.expiryDate ? new Date(u.expiryDate).toLocaleDateString('en-GB',{day:'2-digit',month:'short',year:'numeric'}) : '--';
    const lastActive = u.lastActive ? timeAgo(u.lastActive) : 'Never';
    html += '<div class="login-user-card ' + status + '">' +
      '<div class="login-user-top">' +
        '<div class="login-user-license">' + esc(key) + '</div>' +
        '<div class="login-user-status ' + status + '">' + statusText + '</div>' +
      '</div>' +
      '<div class="login-user-info-grid">' +
        '<div class="login-user-info-item"><span class="login-user-info-label">Expires</span><span class="login-user-info-val neon">' + expDate + '</span></div>' +
        '<div class="login-user-info-item"><span class="login-user-info-label">Devices</span><span class="login-user-info-val">' + deviceCount + ' / ' + deviceLimit + '</span></div>' +
        '<div class="login-user-info-item"><span class="login-user-info-label">Last Active</span><span class="login-user-info-val">' + lastActive + '</span></div>' +
        '<div class="login-user-info-item"><span class="login-user-info-label">Unread</span><span class="login-user-info-val">' + (u.unreadUserMsgs || 0) + ' msg</span></div>' +
      '</div>' +
      '<div class="login-user-actions">' +
        '<button class="login-ua-btn chat" onclick="openChatModal(\'' + esc(key) + '\')"><i class="fa-solid fa-comments"></i> CHAT</button>' +
        '<button class="login-ua-btn edit" onclick="openEditModal(\'' + esc(key) + '\')"><i class="fa-solid fa-pen"></i> EDIT</button>' +
        '<button class="login-ua-btn delete" onclick="openDevicesModal(\'' + esc(key) + '\')"><i class="fa-solid fa-mobile-screen"></i> DEVICES</button>' +
        (u.isBanned
          ? '<button class="login-ua-btn unban" onclick="confirmUnban(\'' + esc(key) + '\')"><i class="fa-solid fa-unlock"></i> UNBAN</button>'
          : '<button class="login-ua-btn ban" onclick="confirmBan(\'' + esc(key) + '\')"><i class="fa-solid fa-ban"></i> BAN</button>') +
      '</div>' +
      '<div style="margin-top:8px">' +
        '<button class="login-ua-btn delete" onclick="confirmDelete(\'' + esc(key) + '\')" style="width:100%;flex-direction:row;justify-content:center;padding:10px"><i class="fa-solid fa-trash"></i> DELETE USER</button>' +
      '</div>' +
    '</div>';
  }
  list.innerHTML = html;
};

window.openCreateModal = function(){
  currentEditKey = null;
  document.getElementById('userModalTitle').textContent = 'CREATE USER';
  document.getElementById('userModalSub').textContent = 'NEW LICENSE KEY';
  document.getElementById('fLicense').value = '';
  document.getElementById('fLicense').disabled = false;
  const t = new Date(); t.setDate(t.getDate() + 30);
  document.getElementById('fExpiry').value = t.toISOString().split('T')[0];
  document.getElementById('fDeviceLimit').value = '1';
  document.getElementById('userModal').classList.add('show');
};

window.openEditModal = function(key){
  currentEditKey = key;
  const u = allUsers[key];
  if (!u) return;
  document.getElementById('userModalTitle').textContent = 'EDIT USER';
  document.getElementById('userModalSub').textContent = key;
  document.getElementById('fLicense').value = key;
  document.getElementById('fLicense').disabled = true;
  if (u.expiryDate){
    const d = new Date(u.expiryDate);
    document.getElementById('fExpiry').value = d.toISOString().split('T')[0];
  }
  document.getElementById('fDeviceLimit').value = u.deviceLimit || 1;
  document.getElementById('userModal').classList.add('show');
};

window.saveUser = function(){
  const btn = document.querySelector('#userModal .login-btn-save');
  if (btn && btn.disabled) return;
  const lic = document.getElementById('fLicense').value.trim();
  const expiry = document.getElementById('fExpiry').value;
  const limit = Math.max(1, parseInt(document.getElementById('fDeviceLimit').value) || 1);
  if (!lic){ notify('error', 'Enter license key!'); return; }
  if (!expiry){ notify('error', 'Select expiry date!'); return; }
  const expiryISO = new Date(expiry + 'T23:59:59').toISOString();
  if (btn) btn.disabled = true;
  const finish = () => { if (btn) btn.disabled = false; };
  if (currentEditKey){
    dbReq('/users/' + encodeURIComponent(currentEditKey), 'PATCH', { expiryDate: expiryISO, deviceLimit: limit })
      .then(() => { notify('success', 'User updated!'); closeLoginModal('userModal'); fetchAll(); })
      .catch(e => notify('error', 'Update failed: ' + e.message))
      .finally(finish);
  } else {
    dbReq('/users/' + encodeURIComponent(lic), 'GET', null).then(snap => {
      if (snap){ notify('error', 'License already exists!'); return; }
      return dbReq('/users/' + encodeURIComponent(lic), 'PUT', {
        expiryDate: expiryISO, deviceLimit: limit, isBanned: false,
        createdAt: Date.now(), unreadUserMsgs: 0, unreadAdminMsgs: 0
      }).then(() => { notify('success', 'User created!'); closeLoginModal('userModal'); fetchAll(); });
    }).catch(e => notify('error', 'Create failed: ' + e.message)).finally(finish);
  }
};

window.confirmBan = function(key){
  document.getElementById('confirmTitle').textContent = 'BAN USER';
  document.getElementById('confirmSub').textContent = 'Ban ' + key + '?';
  document.getElementById('confirmYesBtn').onclick = () => {
    dbReq('users/' + encodeURIComponent(key), 'PATCH', { isBanned: true })
      .then(() => { notify('success', 'User banned'); closeLoginModal('confirmModal'); fetchAll(); });
  };
  document.getElementById('confirmModal').classList.add('show');
};

window.confirmUnban = function(key){
  document.getElementById('confirmTitle').textContent = 'UNBAN USER';
  document.getElementById('confirmSub').textContent = 'Unban ' + key + '?';
  document.getElementById('confirmYesBtn').onclick = () => {
    dbReq('users/' + encodeURIComponent(key), 'PATCH', { isBanned: false })
      .then(() => { notify('success', 'User unbanned'); closeLoginModal('confirmModal'); fetchAll(); });
  };
  document.getElementById('confirmModal').classList.add('show');
};

window.confirmDelete = function(key){
  document.getElementById('confirmTitle').textContent = 'DELETE USER';
  document.getElementById('confirmSub').textContent = 'Delete ' + key + ' permanently?';
  document.getElementById('confirmYesBtn').onclick = () => {
    const btn=document.getElementById('confirmYesBtn'); if(btn.disabled) return; btn.disabled=true;
    dbReq('/users/' + encodeURIComponent(key), 'DELETE', null)
      .then(() => { notify('success', 'User deleted'); closeLoginModal('confirmModal'); fetchAll(); })
      .catch(e => notify('error', 'Delete failed: ' + e.message))
      .finally(() => { btn.disabled=false; });
  };
  document.getElementById('confirmModal').classList.add('show');
};

window.openDevicesModal = function(key){
  const u = allUsers[key];
  if (!u) return;
  document.getElementById('devicesSub').textContent = key;
  const devices = u.devices || {};
  const list = document.getElementById('devicesList');
  const keys = Object.keys(devices);
  if (keys.length === 0){
    list.innerHTML = '<div class="login-empty-state" style="padding:20px"><i class="fa-solid fa-mobile-screen"></i><div>No devices</div></div>';
  } else {
    list.innerHTML = keys.map(dk =>
      '<div class="login-device-item">' +
        '<div class="login-device-icon"><i class="fa-solid fa-mobile-screen-button"></i></div>' +
        '<div class="login-device-info">' +
          '<div class="login-device-model">' + esc(devices[dk].model || 'Unknown') + ' • ' + esc(devices[dk].os || 'Unknown') + '</div>' +
          '<div class="login-device-id">' + esc(dk) + '</div>' +
        '</div>' +
        '<button class="login-device-remove" onclick="removeDevice(\'' + esc(key) + '\',\'' + esc(dk) + '\')"><i class="fa-solid fa-trash"></i></button>' +
      '</div>'
    ).join('');
  }
  document.getElementById('devicesModal').classList.add('show');
};

window.removeDevice = function(userKey, deviceKey){
  dbReq('users/' + encodeURIComponent(userKey) + '/devices/' + encodeURIComponent(deviceKey), 'DELETE', null)
    .then(() => { notify('success', 'Device removed'); openDevicesModal(userKey); fetchAll(); });
};

var chatPollTimer = null;
window.openChatModal = function(key){
  currentChatUser = key;
  document.getElementById('chatUserName').textContent = key;
  document.getElementById('chatModal').classList.add('show');
  dbReq('users/' + encodeURIComponent(key), 'PATCH', { unreadUserMsgs: 0 }).catch(() => {});
  loadChats();
  if (chatPollTimer) clearInterval(chatPollTimer);
  chatPollTimer = setInterval(loadChats, 3000);
};

function loadChats(){
  if (!currentChatUser) return;
  dbReq('users/' + encodeURIComponent(currentChatUser) + '/chats', 'GET', null).then(snap => {
    const box = document.getElementById('adminChatMessages');
    if (!box) return;
    box.innerHTML = '';
    if (snap && typeof snap === 'object'){
      const keys = Object.keys(snap).sort((a,b) => (snap[a].timestamp||0) - (snap[b].timestamp||0));
      for (const k of keys){
        const c = snap[k];
        const time = new Date(c.timestamp).toLocaleTimeString('en-US', {hour:'2-digit', minute:'2-digit'});
        const content = c.type === 'audio' ? '<audio controls src="' + c.msg + '"></audio>' : esc(c.msg);
        box.innerHTML += '<div class="login-msg ' + (c.sender === 'admin' ? 'login-msg-admin' : 'login-msg-user') + '">' + content + '<div class="login-msg-time">' + time + '</div></div>';
      }
      box.scrollTop = box.scrollHeight;
    } else {
      box.innerHTML = '<p style="color:#a5a5b0;text-align:center;font-size:.75rem;margin-top:20px;font-weight:600;">No messages</p>';
    }
  });
}

window.closeChatModal = function(){
  closeLoginModal('chatModal');
  currentChatUser = null;
  if (chatPollTimer) clearInterval(chatPollTimer);
};

window.sendAdminMessage = function(){
  const txt = document.getElementById('adminChatInput').value.trim();
  if (!txt || !currentChatUser) return;
  const key = 'c' + Date.now();
  dbReq('users/' + encodeURIComponent(currentChatUser) + '/chats/' + key, 'PUT', { sender: 'admin', type: 'text', msg: txt, timestamp: Date.now() })
    .then(() => { document.getElementById('adminChatInput').value = ''; loadChats(); });
};

window.toggleAdminRecordVoice = async function(){
  if (!currentChatUser) return;
  const btn = document.getElementById('adminMicBtn');
  if (!isRecording){
    try {
      const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
      mediaRecorder = new MediaRecorder(stream);
      audioChunks = [];
      mediaRecorder.ondataavailable = e => audioChunks.push(e.data);
      mediaRecorder.onstop = () => {
        const blob = new Blob(audioChunks, { type: 'audio/webm' });
        const reader = new FileReader();
        reader.readAsDataURL(blob);
        reader.onloadend = () => {
          const key = 'c' + Date.now();
          dbReq('users/' + encodeURIComponent(currentChatUser) + '/chats/' + key, 'PUT', { sender: 'admin', type: 'audio', msg: reader.result, timestamp: Date.now() })
            .then(() => loadChats());
        };
      };
      mediaRecorder.start();
      isRecording = true;
      btn.classList.add('rec');
      notify('info', 'Recording...');
    } catch(e){ notify('error', 'Mic access denied'); }
  } else {
    mediaRecorder.stop();
    isRecording = false;
    btn.classList.remove('rec');
  }
};

window.openNoticeModal = function(){
  document.getElementById('noticeText').value = '';
  document.getElementById('noticeModal').classList.add('show');
};

window.sendGlobalNotice = function(){
  const text = document.getElementById('noticeText').value.trim();
  if (!text){ notify('error', 'Enter notice text'); return; }
  const keys = Object.keys(allUsers);
  if (keys.length === 0){ notify('error', 'No users'); return; }
  let done = 0;
  keys.forEach(k => {
    dbReq('users/' + encodeURIComponent(k), 'PATCH', { autoNotice: text }).then(() => { done++; }).catch(() => {});
  });
  setTimeout(() => { notify('success', 'Notice sent to ' + done + ' users'); closeLoginModal('noticeModal'); }, 800);
};

window.closeLoginModal = function(id){ document.getElementById(id).classList.remove('show'); };

function notify(type, msg){
  const icons = { success:'fa-check', error:'fa-times', info:'fa-info' };
  const wrap = document.getElementById('adminNotifWrap');
  const el = document.createElement('div');
  el.className = 'admin-notif ' + type;
  el.innerHTML = '<div class="icon-wrap"><i class="fa-solid ' + icons[type] + '"></i></div><div class="msg">' + esc(msg) + '</div>';
  wrap.appendChild(el);
  requestAnimationFrame(() => requestAnimationFrame(() => el.classList.add('show')));
  setTimeout(() => { el.classList.remove('show'); setTimeout(() => el.remove(), 420); }, 2600);
}

document.getElementById('adminChatInput').addEventListener('keypress', e => { if (e.key === 'Enter') sendAdminMessage(); });

window.__loginBootReady = startUsersListener;
})();

/* ══════════════════════════════════════════════════════════
   BOOTSTRAP — init both panels once DOM ready
   ══════════════════════════════════════════════════════════ */
(function(){
  function boot(){
    try { if (typeof window.__homeBootReady === 'function') window.__homeBootReady(); } catch(e){ console.error('Home boot error:', e); }
    try { if (typeof window.__loginBootReady === 'function') window.__loginBootReady(); } catch(e){ console.error('Login boot error:', e); }
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
  else boot();
})();
</script>
