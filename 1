<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>GHOST X PANEL — Admin</title>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<style>
:root{
  --bg:#f7f8fb;--card:#ffffff;
  --gold:#f5b400;--text:#0b0b0f;--muted:#8a8a95;--line:#e6e6ec;
  --green:#0aa356;--red:#d92b3c;--red2:#b01e2c;
  --blue:#2b7de9;--purple:#7a2dd8;
}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{margin:0;padding:0;background:var(--bg);color:var(--text);font-family:'Inter',Roboto,-apple-system,'Segoe UI',Arial,sans-serif;min-height:100vh;overflow-x:hidden}
.wrap{max-width:1120px;margin:auto;padding:22px 14px 50px}

/* TAB BAR */
.admin-tab-bar{
  display:grid;grid-template-columns:1fr 1fr;gap:0;
  background:#f2f2f4;padding:5px;border-radius:14px;
  margin-bottom:22px;border:1.5px solid #e6e6ec;
}
.admin-tab{
  padding:14px 12px;border-radius:10px;border:none;background:transparent;
  color:#5a5a66;font-size:12.5px;font-weight:900;letter-spacing:1.2px;
  cursor:pointer;font-family:inherit;transition:all .25s cubic-bezier(.2,.9,.3,1.2);
  display:flex;align-items:center;justify-content:center;gap:8px;
  text-transform:uppercase;
}
.admin-tab:hover{color:#0b0b0f}
.admin-tab.active{background:linear-gradient(135deg,#ffc933,#f0a500);color:#0b0b0f;box-shadow:0 4px 14px rgba(245,180,0,.35)}
.tab-panel{display:none}
.tab-panel.active{display:block;animation:tabFade .3s ease}
@keyframes tabFade{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}

/* HEADERS */
.top{padding:22px 2px 18px;border-bottom:2px solid #111;display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:22px}
.brand{display:flex;align-items:center;gap:12px}
.mark{width:44px;height:44px;border-radius:14px;background:linear-gradient(145deg,#29292f,#0d0d10);border:1px solid #3a3a42;color:#fff;display:grid;place-items:center;font-size:22px}
.brand h1{font-size:17px;margin:0;letter-spacing:1.5px;font-weight:900;color:#0b0b0f}
.brand p{margin:2px 0 0;color:#8d8d96;font-size:11px;letter-spacing:2px}
.tag{font-size:10px;letter-spacing:1.5px;color:#0b0b0f;border:1.5px solid #cfcfd6;background:#fff;padding:6px 9px;border-radius:99px;font-weight:900}

.stats{display:flex;gap:8px;margin:0 0 18px;flex-wrap:wrap}
.stat{flex:1;min-width:90px;padding:12px;border:2px solid var(--gold);border-radius:14px;background:#fff}
.stat b{display:block;font-size:22px;color:#0b0b0f;font-weight:900;line-height:1}
.stat span{font-size:9.5px;color:#8a8a95;letter-spacing:1px;font-weight:700;margin-top:4px;display:block}

.layout{display:grid;grid-template-columns:1fr;gap:18px}
.card-panel{background:#fff;border:2px solid var(--gold);border-radius:16px;padding:20px 16px;margin-bottom:18px}
.card-panel h2{font-size:16px;margin:0 0 4px;color:#0b0b0f;font-weight:900;display:flex;align-items:center;gap:8px}
.card-panel h2 svg{width:18px;height:18px;flex-shrink:0}
.card-panel .sub{font-size:11px;color:#8a8a95;margin:0 0 16px;line-height:1.5}
.field{margin:0 0 14px}
.field label{display:block;color:#0b0b0f;font-size:10.5px;font-weight:900;letter-spacing:.9px;margin-bottom:6px;text-transform:uppercase}
.field input,.field textarea,.field select{width:100%;border:1.5px solid #cfcfd6;border-radius:12px;background:#fff;color:#0b0b0f;padding:12px 14px;font:inherit;font-size:14px;outline:none;font-family:inherit}
.field input:focus,.field textarea:focus,.field select:focus{border-color:var(--gold);box-shadow:0 0 0 4px rgba(245,180,0,.12)}
.field textarea{min-height:70px;resize:vertical;font-family:ui-monospace,Menlo,Consolas,monospace;font-size:12.5px;line-height:1.6}
.field .hint{font-size:10px;color:#8a8a95;margin-top:5px;line-height:1.5}
.two{display:grid;grid-template-columns:1fr 1fr;gap:10px}

.seg-tabs{display:grid;grid-template-columns:1fr 1fr;gap:0;background:#f2f2f4;padding:5px;border-radius:14px;margin-bottom:18px;border:1.5px solid #e6e6ec}
.seg-tab{padding:12px 10px;border-radius:10px;border:none;background:transparent;color:#5a5a66;font-size:13px;font-weight:900;letter-spacing:.8px;cursor:pointer;font-family:inherit;transition:all .2s;display:flex;align-items:center;justify-content:center;gap:8px}
.seg-tab svg{width:16px;height:16px}
.seg-tab.active{background:#fff;color:#0b0b0f;box-shadow:0 2px 8px rgba(15,15,25,.1)}
.seg-tab.active.gold{background:linear-gradient(135deg,#ffc933,#f0a500);color:#0b0b0f}
.seg-tab.active.red{background:linear-gradient(135deg,#e84b5f,#b01e2c);color:#fff}

.cat-tabs{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:14px}
.cat-tab{padding:8px 14px;border-radius:99px;border:1.5px solid #cfcfd6;background:#fff;color:#0b0b0f;font-size:11.5px;font-weight:900;letter-spacing:.6px;cursor:pointer;font-family:inherit;transition:all .2s}
.cat-tab:hover{border-color:var(--gold)}
.cat-tab.active{background:linear-gradient(135deg,#ffc933,#f0a500);border-color:var(--gold);color:#0b0b0f}

.color-picker{display:flex;gap:10px;flex-wrap:wrap;margin-top:8px}
.color-option{width:44px;height:44px;border-radius:50%;cursor:pointer;border:3px solid transparent;transition:all .2s;position:relative}
.color-option:hover{transform:scale(1.08)}
.color-option.active{border-color:#0b0b0f;box-shadow:0 0 0 3px rgba(15,15,25,.1)}
.color-option.active::after{content:"✓";position:absolute;inset:0;display:grid;place-items:center;color:#fff;font-weight:900;font-size:18px;text-shadow:0 1px 3px rgba(0,0,0,.4)}
.color-option.red{background:linear-gradient(135deg,#ff5c70,#b01e2c)}
.color-option.blue{background:linear-gradient(135deg,#5cafff,#1e5d9c)}
.color-option.purple{background:linear-gradient(135deg,#b44dff,#5a1d9c)}
.color-option.green{background:linear-gradient(135deg,#4dd97b,#0a8052)}
.color-option.gold{background:linear-gradient(135deg,#ffd84d,#b58600)}
.color-option.orange{background:linear-gradient(135deg,#ff944d,#b85500)}

.svg-picker{display:grid;grid-template-columns:repeat(5,1fr);gap:8px;margin-top:8px;background:#fafafd;border:1.5px solid #e6e6ec;border-radius:12px;padding:10px}
.svg-pick{aspect-ratio:1;border-radius:10px;border:1.5px solid #e6e6ec;background:#fff;cursor:pointer;display:grid;place-items:center;transition:all .15s;padding:6px}
.svg-pick:hover{border-color:var(--gold);transform:translateY(-2px)}
.svg-pick.active{border-color:var(--gold);background:#fffbee;box-shadow:0 0 0 3px rgba(245,180,0,.15)}
.svg-pick svg{width:24px;height:24px;display:block}

.subcat-preview-card{background:#fafafd;border:1.5px dashed #d5d5dd;border-radius:12px;padding:14px;display:flex;align-items:center;gap:14px;margin-top:14px}
.subcat-icon-wrap{width:56px;height:56px;border-radius:50%;display:grid;place-items:center;border:3px solid #ffffff;overflow:hidden;flex-shrink:0}
.subcat-icon-wrap img{width:100%;height:100%;object-fit:cover;display:block}
.subcat-icon-wrap svg{width:28px;height:28px;color:#fff;display:block}
.subcat-icon-wrap.red{background:linear-gradient(135deg,#ff5c70,#b01e2c);box-shadow:0 6px 16px rgba(217,43,60,.35),inset 0 2px 4px rgba(255,255,255,.3)}
.subcat-icon-wrap.blue{background:linear-gradient(135deg,#5cafff,#1e5d9c);box-shadow:0 6px 16px rgba(43,125,233,.35),inset 0 2px 4px rgba(255,255,255,.3)}
.subcat-icon-wrap.purple{background:linear-gradient(135deg,#b44dff,#5a1d9c);box-shadow:0 6px 16px rgba(122,45,216,.35),inset 0 2px 4px rgba(255,255,255,.3)}
.subcat-icon-wrap.green{background:linear-gradient(135deg,#4dd97b,#0a8052);box-shadow:0 6px 16px rgba(10,163,86,.35),inset 0 2px 4px rgba(255,255,255,.3)}
.subcat-icon-wrap.gold{background:linear-gradient(135deg,#ffd84d,#b58600);box-shadow:0 6px 16px rgba(245,180,0,.4),inset 0 2px 4px rgba(255,255,255,.3)}
.subcat-icon-wrap.orange{background:linear-gradient(135deg,#ff944d,#b85500);box-shadow:0 6px 16px rgba(255,122,24,.35),inset 0 2px 4px rgba(255,255,255,.3)}
.subcat-preview-info{flex:1;min-width:0}
.subcat-preview-name{font-size:15px;font-weight:900;color:#0b0b0f;text-transform:uppercase;letter-spacing:.5px}
.subcat-preview-desc{font-size:11.5px;color:#8a8a95;margin-top:4px;font-weight:600;overflow-wrap:anywhere}
.subcat-list{display:grid;gap:10px;margin-top:14px}
.subcat-row{display:flex;align-items:center;gap:14px;padding:12px;border:2px solid var(--gold);border-radius:14px;background:#fff}

.section-head{display:flex;align-items:center;gap:10px;margin:20px 0 12px;padding:10px 12px;background:#fafafd;border:1.5px dashed #d5d5dd;border-radius:12px}
.section-head .icon{width:30px;height:30px;border-radius:9px;display:grid;place-items:center;flex-shrink:0;color:#fff}
.section-head .icon svg{width:16px;height:16px}
.section-head .icon.activate{background:linear-gradient(135deg,#4dd97b,#0a8052)}
.section-head .icon.deactivate{background:linear-gradient(135deg,#ff5c70,#b01e2c)}
.section-head .label{font-size:11.5px;font-weight:900;letter-spacing:1.2px;text-transform:uppercase;color:#0b0b0f}

.btn{border:none;border-radius:12px;padding:14px 18px;font-weight:900;cursor:pointer;font-family:inherit;font-size:13px;letter-spacing:.8px;transition:all .2s;display:inline-flex;align-items:center;justify-content:center;gap:8px}
.btn svg{width:15px;height:15px;flex-shrink:0}
.btn.primary{color:#fff;background:#0b0b0f}
.btn.primary:hover{background:#1a1a22}
.btn.secondary{background:#fff;color:#0b0b0f;border:1.5px solid #cfcfd6}
.btn.secondary:hover{border-color:#0b0b0f}
.btn.danger{background:var(--red);color:#fff}
.btn.danger:hover{background:var(--red2)}
.btn.gold{background:linear-gradient(135deg,#ffc933,#f0a500);color:#0b0b0f;border:none;font-size:15px;padding:16px 20px}
.btn:disabled{opacity:.5;cursor:not-allowed}
.btn.small{font-size:11px;padding:8px 12px;border-radius:9px}
.btn.tiny{font-size:10px;padding:6px 9px;border-radius:8px}
.actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:18px}
.notice{font-size:12px;color:#5a5a66;padding:12px 14px;border:1.5px solid #e6e6ec;border-radius:12px;background:#fafafd;margin-top:14px;white-space:pre-wrap;overflow-wrap:anywhere;line-height:1.55;font-weight:500}
.notice.ok{border-color:#b8e5ca;color:#0a8052;background:#e8f8ef}
.notice.err{border-color:#f5bcc3;color:#b01e2c;background:#fde8eb}
.notice.info{border-color:#f5d78e;color:#8a6100;background:#fff3d6}
.products{display:grid;gap:12px}
.product{display:grid;grid-template-columns:60px minmax(0,1fr);gap:12px;padding:14px;border:2px solid var(--gold);border-radius:14px;background:#fff}
.thumb{width:60px;height:60px;border-radius:10px;object-fit:cover;background:#0b0b0f;border:1.5px solid var(--gold)}
.thumb.blank{display:grid;place-items:center;color:var(--gold);background:#0b0b0f}
.thumb.blank svg{width:22px;height:22px}
.phead{display:flex;justify-content:space-between;gap:8px;align-items:start}
.pname{font-weight:900;overflow-wrap:anywhere;font-size:14px;color:#0b0b0f}
.pill{font-size:9.5px;padding:4px 9px;border-radius:99px;background:#e6f7ed;color:var(--green);border:1.5px solid #b8e5ca;white-space:nowrap;font-weight:900;letter-spacing:.5px}
.pill.off{background:#fde8eb;color:var(--red);border-color:#f5bcc3}
.pill.cat-free{background:#e6f0ff;color:#1e6bd8;border-color:#b8d0f5}
.pill.cat-premium{background:#fff3d6;color:#b57c00;border-color:#f5d78e}
.pill.cat-other{background:#f0f0f0;color:#5a5a66;border-color:#cfcfd6}
.meta{font-size:11px;color:#5a5a66;overflow-wrap:anywhere;margin:8px 0 10px;line-height:1.65}
.meta b{color:#0b0b0f;font-weight:800}
.meta .tag-a{color:var(--green);font-weight:900}
.meta .tag-d{color:var(--red);font-weight:900}
.pactions{display:flex;gap:6px;flex-wrap:wrap}
.foot{text-align:center;color:#aaa;font-size:11px;letter-spacing:1.5px;padding:28px 8px 10px;font-weight:700}
.status-log{font-family:ui-monospace,Menlo,Consolas,monospace;font-size:11px;line-height:1.7;max-height:140px;overflow-y:auto;margin-top:10px;padding:10px;background:#0a0a0a;border-radius:8px;color:#0f0;border:1.5px solid #333}
.status-log .line{display:block;margin:2px 0}
.status-log .line.ok{color:#0f0}
.status-log .line.err{color:#f55}
.status-log .line.info{color:#ff0}
.pu-list{display:grid;gap:12px;margin-top:16px}
.pu-row{border:2px solid var(--gold);border-radius:14px;padding:14px;background:#fff}
.pu-row.banned{border-color:#cfcfd6;background:#fafafd;opacity:.9}
.pu-head{display:flex;justify-content:space-between;align-items:start;gap:8px;margin-bottom:8px}
.pu-name{font-weight:900;font-size:15px;color:#0b0b0f}
.pu-id{font-family:ui-monospace,Menlo,Consolas,monospace;font-size:11px;color:#5a5a66;background:#fafafd;padding:6px 10px;border-radius:8px;border:1px solid #e6e6ec;display:block;margin:6px 0;overflow-wrap:anywhere;word-break:break-all}
.pu-meta{font-size:11.5px;color:#5a5a66;line-height:1.8}
.pu-meta b{color:#0b0b0f}
.pu-cats{display:flex;gap:5px;flex-wrap:wrap;margin-top:8px}
.pu-cat-pill{font-size:10px;padding:4px 9px;border-radius:99px;background:#e6f0ff;color:#1e6bd8;border:1.5px solid #b8d0f5;font-weight:900;display:inline-flex;align-items:center;gap:5px}
.pu-cat-pill svg{width:12px;height:12px}
.pu-cat-pill.on{background:#e6f7ed;color:#0a8052;border-color:#b8e5ca}
.pu-cat-pill.exp{background:#fde8eb;color:#b01e2c;border-color:#f5bcc3;text-decoration:line-through;opacity:.92}
.pu-cat-pill .exp-tag{font-size:8px;letter-spacing:.5px;text-decoration:none;font-weight:900;margin-left:2px}
.pu-actions{display:flex;gap:5px;flex-wrap:wrap;margin-top:10px}
.status-badge{font-size:10px;padding:4px 10px;border-radius:99px;font-weight:900;white-space:nowrap}
.status-badge.active{background:#e6f7ed;color:var(--green);border:1.5px solid #b8e5ca}
.status-badge.warn{background:#fff3d6;color:#b57c00;border:1.5px solid #f5d78e}
.status-badge.exp{background:#fde8eb;color:var(--red);border:1.5px solid #f5bcc3}
.status-badge.ban{background:#f0f0f0;color:#5a5a66;border:1.5px solid #cfcfd6}
.cat-check-list{display:grid;gap:8px;background:#fafafd;border:1.5px solid #e6e6ec;border-radius:12px;padding:12px;margin-top:6px}
.cat-check{display:flex;align-items:center;gap:10px;padding:8px 10px;border-radius:9px;background:#fff;border:1.5px solid #e6e6ec;cursor:pointer;transition:all .15s}
.cat-check:hover{border-color:var(--gold)}
.cat-check input{width:18px;height:18px;accent-color:#0b0b0f;cursor:pointer;flex-shrink:0}
.cat-check .cc-icon{width:22px;height:22px;border-radius:6px;display:grid;place-items:center;flex-shrink:0;color:#fff}
.cat-check .cc-icon svg{width:14px;height:14px}
.cat-check .cc-name{font-size:12.5px;font-weight:800;color:#0b0b0f;flex:1}
.cat-check.checked{border-color:var(--gold);background:#fffbee}
.cat-check-empty{font-size:11px;color:#8a8a95;text-align:center;padding:6px}
.modal-bg{position:fixed;inset:0;z-index:9998;background:rgba(0,0,0,.6);display:none;align-items:center;justify-content:center;padding:20px;backdrop-filter:blur(4px)}
.modal-bg.show{display:flex}
.modal-card{background:#fff;border-radius:18px;padding:24px 20px;max-width:460px;width:100%;box-shadow:0 24px 60px rgba(0,0,0,.3);border:2px solid var(--gold);max-height:90vh;overflow-y:auto;position:relative}
.modal-close{position:absolute;top:12px;right:12px;width:34px;height:34px;border-radius:50%;background:#f2f2f4;border:none;color:#5a5a66;font-size:18px;font-weight:900;cursor:pointer;display:grid;place-items:center;z-index:2}
.modal-card h3{margin:0 0 4px;font-size:16px;font-weight:900;color:#0b0b0f}
.modal-card .msub{font-size:11.5px;color:#8a8a95;margin:0 0 16px;line-height:1.5}
.modal-section{display:none}
.modal-section.show{display:block}

/* LOGIN ADMIN PANEL STYLES (for user management) */
.login-stats-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px;margin-bottom:18px}
@media(min-width:600px){.login-stats-grid{grid-template-columns:repeat(4,1fr)}}
.login-stat-card{background:#fff;border:2px solid var(--gold);border-radius:14px;padding:14px 12px;position:relative;overflow:hidden}
.login-stat-card::before{content:'';position:absolute;top:0;left:0;right:0;height:4px}
.login-stat-card.total::before{background:linear-gradient(90deg,var(--blue),var(--purple))}
.login-stat-card.active::before{background:linear-gradient(90deg,var(--green),#087a41)}
.login-stat-card.expired::before{background:linear-gradient(90deg,var(--gold),var(--gold-deep))}
.login-stat-card.banned::before{background:linear-gradient(90deg,var(--red),var(--red2))}
.login-stat-icon{width:32px;height:32px;border-radius:9px;display:grid;place-items:center;margin-bottom:8px;font-size:.85rem;color:#fff}
.login-stat-card.total .login-stat-icon{background:linear-gradient(135deg,var(--blue),var(--purple))}
.login-stat-card.active .login-stat-icon{background:linear-gradient(135deg,var(--green),#087a41)}
.login-stat-card.expired .login-stat-icon{background:linear-gradient(135deg,var(--gold),var(--gold-deep))}
.login-stat-card.banned .login-stat-icon{background:linear-gradient(135deg,var(--red),var(--red2))}
.login-stat-num{font-size:1.5rem;font-weight:900;color:var(--text);line-height:1;font-family:'Orbitron',sans-serif}
.login-stat-label{font-size:.58rem;font-weight:800;letter-spacing:1.5px;color:var(--muted);text-transform:uppercase;margin-top:5px}
.login-broadcast-btn{width:100%;padding:14px;background:linear-gradient(135deg,var(--blue),var(--purple));color:#fff;border:none;border-radius:14px;cursor:pointer;font-family:inherit;font-weight:900;font-size:.8rem;letter-spacing:1.5px;margin-bottom:16px;display:flex;align-items:center;justify-content:center;gap:10px;text-transform:uppercase;box-shadow:0 6px 20px rgba(122,45,216,.25)}
.login-broadcast-btn:active{transform:scale(.98)}
.login-action-bar{display:flex;gap:10px;margin-bottom:16px}
.login-search-wrap{flex:1;position:relative}
.login-search-wrap i{position:absolute;left:16px;top:50%;transform:translateY(-50%);color:var(--muted);font-size:.85rem}
.login-search-wrap input{width:100%;padding:14px 16px 14px 46px;background:#fff;border:1.5px solid var(--line);border-radius:999px;color:var(--text);font-size:.85rem;font-weight:600;font-family:inherit;outline:none}
.login-search-wrap input:focus{border-color:var(--gold);box-shadow:0 0 0 4px rgba(245,180,0,.12)}
.login-add-user-btn{background:#0b0b0f;color:#fff;border:none;padding:14px 20px;border-radius:999px;font-family:inherit;font-weight:900;font-size:.8rem;letter-spacing:1.5px;cursor:pointer;display:flex;align-items:center;gap:8px;text-transform:uppercase}
.login-add-user-btn:active{transform:scale(.97)}
.login-users-list{display:grid;gap:12px}
.login-user-card{background:#fff;border:1.5px solid var(--line);border-radius:16px;padding:16px;position:relative;overflow:hidden;animation:loginCardIn .35s ease both}
@keyframes loginCardIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
.login-user-card.banned{border-color:rgba(217,43,60,.4)}
.login-user-card.expired{border-color:rgba(245,180,0,.4)}
.login-user-card::before{content:'';position:absolute;left:0;top:0;bottom:0;width:4px}
.login-user-card.active::before{background:linear-gradient(180deg,var(--green),#087a41)}
.login-user-card.expired::before{background:linear-gradient(180deg,var(--gold),var(--gold-deep))}
.login-user-card.banned::before{background:linear-gradient(180deg,var(--red),var(--red2))}
.login-user-top{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:12px}
.login-user-license{font-family:'JetBrains Mono',monospace;font-size:.9rem;font-weight:800;color:var(--text);word-break:break-all;flex:1}
.login-user-status{padding:5px 12px;border-radius:999px;font-size:.6rem;font-weight:900;letter-spacing:1px;text-transform:uppercase;white-space:nowrap}
.login-user-status.active{background:rgba(10,163,86,.12);color:var(--green)}
.login-user-status.expired{background:rgba(245,180,0,.15);color:var(--gold-deep)}
.login-user-status.banned{background:rgba(217,43,60,.12);color:var(--red)}
.login-user-info-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:8px;margin-bottom:14px;padding:12px;background:var(--soft);border-radius:12px}
.login-user-info-item{display:flex;flex-direction:column;gap:3px}
.login-user-info-label{font-size:.58rem;font-weight:800;letter-spacing:1px;color:var(--muted);text-transform:uppercase}
.login-user-info-val{font-family:'JetBrains Mono',monospace;font-size:.72rem;font-weight:800;color:var(--text);overflow-wrap:anywhere}
.login-user-info-val.neon{color:var(--gold-deep)}
.login-user-actions{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}
.login-ua-btn{padding:10px 6px;border-radius:10px;border:1.5px solid var(--line);background:#fff;color:var(--text);cursor:pointer;font-family:inherit;font-weight:800;font-size:.62rem;letter-spacing:.5px;display:flex;flex-direction:column;align-items:center;gap:5px;transition:all .2s;text-transform:uppercase}
.login-ua-btn i{font-size:.95rem}
.login-ua-btn:active{transform:scale(.95)}
.login-ua-btn.chat{border-color:rgba(43,125,233,.3);color:var(--blue)}
.login-ua-btn.edit{border-color:rgba(245,180,0,.3);color:var(--gold-deep)}
.login-ua-btn.ban{border-color:rgba(217,43,60,.3);color:var(--red)}
.login-ua-btn.delete{border-color:rgba(217,43,60,.3);color:var(--red)}
.login-ua-btn.unban{border-color:rgba(10,163,86,.3);color:var(--green)}
.login-empty-state{background:#fff;border:1.5px dashed var(--line);border-radius:16px;padding:40px 20px;text-align:center;color:var(--muted);font-size:.85rem;font-weight:600}
.login-empty-state i{font-size:2rem;color:var(--muted);margin-bottom:12px;opacity:.5}
.login-modal-overlay{position:fixed;inset:0;background:rgba(11,11,15,.72);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);display:none;justify-content:center;align-items:center;z-index:500;padding:16px}
.login-modal-overlay.show{display:flex}
.login-modal-card{background:#fff;width:100%;max-width:420px;max-height:88vh;overflow-y:auto;padding:26px 22px;border-radius:22px;border:2px solid var(--gold);position:relative;box-shadow:0 24px 60px rgba(0,0,0,.35)}
.login-modal-card::before{content:'';position:absolute;top:0;left:0;right:0;height:4px;background:linear-gradient(90deg,var(--gold),var(--gold-2));border-radius:22px 22px 0 0}
.login-modal-title{font-family:'Orbitron',sans-serif;font-size:.95rem;font-weight:900;letter-spacing:2px;text-align:center;margin-bottom:6px;color:var(--text);text-transform:uppercase}
.login-modal-sub{font-family:'JetBrains Mono',monospace;font-size:.55rem;color:var(--muted);letter-spacing:1.5px;text-align:center;margin-bottom:20px;font-weight:700;text-transform:uppercase}
.login-form-group{margin-bottom:14px}
.login-form-label{display:block;font-size:.65rem;font-weight:800;letter-spacing:1.5px;color:var(--muted);text-transform:uppercase;margin-bottom:8px}
.login-form-input{width:100%;padding:14px 16px;background:#fff;border:1.5px solid #cfcfd6;border-radius:12px;color:var(--text);font-size:.85rem;font-weight:600;font-family:inherit;outline:none}
.login-form-input:focus{border-color:var(--gold);box-shadow:0 0 0 4px rgba(245,180,0,.12)}
.login-form-input::placeholder{color:#a5a5b0;font-weight:500}
.login-form-actions{display:flex;gap:10px;margin-top:20px}
.login-btn-cancel,.login-btn-save{flex:1;padding:14px;border:none;border-radius:12px;cursor:pointer;font-family:inherit;font-weight:900;font-size:.78rem;letter-spacing:1.5px;text-transform:uppercase;display:flex;align-items:center;justify-content:center;gap:8px}
.login-btn-cancel{background:var(--soft);color:var(--text)}
.login-btn-save{background:#0b0b0f;color:#fff}
.login-btn-danger{background:linear-gradient(135deg,var(--red),var(--red2));color:#fff}
.login-chat-card{background:#fff;width:100%;max-width:420px;height:520px;max-height:88vh;border:2px solid var(--gold);border-radius:22px;padding:16px;display:flex;flex-direction:column;position:relative;overflow:hidden}
.login-chat-card::before{content:'';position:absolute;top:0;left:0;right:0;height:4px;background:linear-gradient(90deg,var(--gold),var(--gold-2))}
.login-chat-header{display:flex;align-items:center;gap:10px;padding-bottom:10px;border-bottom:1.5px solid var(--line);margin-bottom:10px}
.login-chat-user{flex:1;font-family:'JetBrains Mono',monospace;font-size:.75rem;font-weight:800;color:var(--text);overflow-wrap:anywhere}
.login-chat-close{width:34px;height:34px;border-radius:50%;background:var(--soft);border:none;color:var(--text);cursor:pointer;display:grid;place-items:center;font-size:.85rem}
.login-chat-msgs{flex:1;overflow-y:auto;display:flex;flex-direction:column;gap:10px;padding:12px;background:var(--soft);border-radius:14px;margin-bottom:10px}
.login-msg{padding:10px 14px;border-radius:12px;font-size:.78rem;max-width:85%;word-break:break-word;font-weight:600}
.login-msg-user{background:#fff;border:1.5px solid var(--line);color:var(--text);align-self:flex-start;border-bottom-left-radius:4px}
.login-msg-admin{background:linear-gradient(135deg,var(--gold),var(--gold-2));color:#0b0b0f;font-weight:700;align-self:flex-end;border-bottom-right-radius:4px}
.login-msg-time{font-size:.55rem;color:var(--muted);margin-top:4px;font-family:'JetBrains Mono',monospace;font-weight:700}
.login-msg-admin .login-msg-time{color:rgba(11,11,15,.5)}
.login-chat-input-area{display:flex;gap:8px;align-items:center}
.login-chat-input-area input{flex:1;min-width:0;padding:12px 14px;background:var(--soft);border:1.5px solid transparent;border-radius:12px;outline:none;font-size:.8rem;font-family:inherit;font-weight:600;color:var(--text)}
.login-chat-input-area input:focus{border-color:var(--gold);background:#fff}
.login-chat-btn{width:42px;height:42px;min-width:42px;border-radius:50%;background:#fff;border:1.5px solid var(--line);color:var(--text);cursor:pointer;display:grid;place-items:center;font-size:.85rem}
.login-chat-btn.rec{background:linear-gradient(135deg,var(--red),var(--red2));color:#fff;border-color:transparent}
.login-chat-btn.send{background:#0b0b0f;color:#fff;border:none}
.login-device-item{display:flex;align-items:center;gap:10px;padding:12px;background:var(--soft);border-radius:12px;margin-bottom:8px}
.login-device-icon{width:36px;height:36px;border-radius:10px;background:linear-gradient(135deg,var(--blue),var(--purple));color:#fff;display:grid;place-items:center;font-size:.85rem;flex-shrink:0}
.login-device-info{flex:1;min-width:0}
.login-device-model{font-size:.75rem;font-weight:800;color:var(--text);margin-bottom:2px}
.login-device-id{font-family:'JetBrains Mono',monospace;font-size:.6rem;color:var(--muted);font-weight:700;overflow-wrap:anywhere}
.login-device-remove{background:rgba(217,43,60,.08);border:1.5px solid rgba(217,43,60,.25);color:var(--red);width:34px;height:34px;border-radius:10px;display:grid;place-items:center;cursor:pointer;font-size:.75rem}
.login-notice-textarea{width:100%;padding:14px;min-height:120px;background:#fff;border:1.5px solid #cfcfd6;border-radius:12px;color:var(--text);font-size:.85rem;font-weight:600;font-family:inherit;outline:none;resize:vertical}
.login-notice-textarea:focus{border-color:var(--gold);box-shadow:0 0 0 4px rgba(245,180,0,.12)}
.login-notice-info{font-size:.72rem;color:var(--muted);font-weight:600;margin-top:8px;line-height:1.5}

/* TOAST */
#adminNotifWrap{position:fixed;bottom:20px;left:0;right:0;z-index:99999;display:flex;flex-direction:column;align-items:center;gap:10px;padding:0 16px;pointer-events:none}
.admin-notif{background:#fff;color:var(--text);border-radius:14px;padding:14px 18px;display:flex;align-items:center;gap:12px;box-shadow:0 12px 32px rgba(15,15,25,.18);border:1.5px solid var(--line);max-width:400px;width:100%;transform:translateY(120px);opacity:0;transition:transform .38s cubic-bezier(.2,.9,.3,1.15),opacity .3s;position:relative;overflow:hidden}
.admin-notif.show{transform:translateY(0);opacity:1}
.admin-notif::before{content:'';position:absolute;left:0;top:0;bottom:0;width:5px;background:var(--gold);border-radius:14px 0 0 14px}
.admin-notif.success::before{background:var(--green)}
.admin-notif.error::before{background:var(--red)}
.admin-notif .icon-wrap{width:36px;height:36px;border-radius:50%;display:grid;place-items:center;font-size:.9rem;flex-shrink:0;color:#fff}
.admin-notif.success .icon-wrap{background:var(--green)}
.admin-notif.error .icon-wrap{background:var(--red)}
.admin-notif.info .icon-wrap{background:var(--gold)}
.admin-notif .msg{font-size:.82rem;font-weight:800;color:var(--text);line-height:1.35;flex:1}

@media(min-width:780px){.layout{grid-template-columns:minmax(0,1fr) minmax(0,1fr)}}
@media(max-width:420px){.two{grid-template-columns:1fr}.wrap{padding:16px 10px 35px}.card-panel{padding:14px}.svg-picker{grid-template-columns:repeat(4,1fr)}}
</style>
</head>
<body>
<div class="wrap">

  <!-- TAB BAR -->
  <div class="admin-tab-bar">
    <button class="admin-tab active" data-tab="home" type="button">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
      HOME ADMIN
    </button>
    <button class="admin-tab" data-tab="login" type="button">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
      LOGIN ADMIN
    </button>
  </div>

  <!-- HOME ADMIN TAB CONTENT -->
  <div class="tab-panel active" id="tabHome">
    <header class="top">
      <div class="brand">
        <div class="mark">
          <svg viewBox="0 0 24 24" fill="currentColor" width="22" height="22"><path d="M12 2l2.8 6.5 7.2.6-5.4 4.8 1.6 7-6.2-3.7-6.2 3.7 1.6-7-5.4-4.8 7.2-.6z"/></svg>
        </div>
        <div><h1>GHOST X PANEL</h1><p>ADMIN CONTROL CENTER</p></div>
      </div>
      <span class="tag">HOME ADMIN</span>
    </header>

    <div class="stats">
      <div class="stat"><b id="totalCount">0</b><span>TOTAL</span></div>
      <div class="stat"><b id="activeCount">0</b><span>ACTIVE</span></div>
      <div class="stat"><b id="freeCount">0</b><span>FREE</span></div>
      <div class="stat"><b id="premiumCount">0</b><span>PREMIUM</span></div>
      <div class="stat"><b id="otherCount">0</b><span>OTHER</span></div>
    </div>

    <div class="layout">
      <div>
        <section class="card-panel">
          <h2><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15 15 0 0 1 0 20 15 15 0 0 1 0-20"/></svg> Global Task</h2>
          <p class="sub">সব user এর কাছে auto apply হবে।</p>
          <div class="seg-tabs" id="globalTabs">
            <button class="seg-tab active gold" data-tab="push" type="button"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v13"/><path d="M19 9l-7 7-7-7"/><path d="M5 21h14"/></svg> PUSH</button>
            <button class="seg-tab" data-tab="delete" type="button"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6M14 11v6"/></svg> DELETE</button>
          </div>
          <div class="modal-section show" id="globalPushSection">
            <div class="field"><label>File URL *</label><input id="pushUrl" type="url" placeholder="https://..."></div>
            <div class="field"><label>File name *</label><input id="pushFileName" placeholder="config.zip" maxlength="120"></div>
            <div class="field"><label>Target path (full) *</label><input id="pushTargetPath" placeholder="Android/data/com.dts.freefiremax/files" maxlength="300"></div>
            <div class="actions">
              <button id="pushBtn" class="btn gold" type="button">PUSH NOW</button>
              <button id="pushClearBtn" class="btn secondary" type="button">CLEAR</button>
            </div>
            <div id="pushMsg" class="notice">Ready.</div>
            <div id="pushLog" class="status-log"></div>
          </div>
          <div class="modal-section" id="globalDeleteSection">
            <div class="field"><label>Delete path (full) *</label><input id="delPath" placeholder="Android/data/com.dts.freefiremax/files" maxlength="300"></div>
            <div class="field"><label>Delete names *</label><textarea id="delNames" placeholder="config.json&#10;profile"></textarea></div>
            <div class="actions">
              <button id="deleteBtn" class="btn danger" type="button">DELETE NOW</button>
              <button id="delClearBtn" class="btn secondary" type="button">CLEAR</button>
            </div>
            <div id="delMsg" class="notice">Ready.</div>
            <div id="delLog" class="status-log"></div>
          </div>
        </section>

        <section class="card-panel">
          <h2><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg> Premium Categories</h2>
          <p class="sub">Premium এর ভিতরে categories তৈরি করো (যেমন: Tournament, Gunskin)।</p>
          <input id="scEditId" type="hidden">
          <div class="field">
            <label>Icon Type</label>
            <div class="icon-type-tabs" id="scIconTypeTabs">
              <button class="icon-type-tab active" data-type="svg" type="button"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><circle cx="12" cy="12" r="9"/></svg> ICON</button>
              <button class="icon-type-tab" data-type="image" type="button"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg> IMAGE</button>
            </div>
          </div>
          <div id="scSvgSection">
            <div class="field">
              <label>Icon *</label>
              <div class="svg-picker" id="scSvgPicker"></div>
              <div class="hint">যেকোনো icon select করো।</div>
            </div>
          </div>
          <div id="scImageSection" style="display:none">
            <div class="field">
              <label>Image URL *</label>
              <input id="scImageUrl" type="url" placeholder="https://example.com/icon.png">
            </div>
          </div>
          <div class="field"><label>Name *</label><input id="scName" placeholder="Tournament" maxlength="40"></div>
          <div class="field"><label>Description (optional)</label><input id="scDesc" placeholder="Tournament configs" maxlength="80"></div>
          <div class="field">
            <label>Color *</label>
            <div class="color-picker" id="scColorPicker">
              <div class="color-option red active" data-color="red"></div>
              <div class="color-option blue" data-color="blue"></div>
              <div class="color-option purple" data-color="purple"></div>
              <div class="color-option green" data-color="green"></div>
              <div class="color-option gold" data-color="gold"></div>
              <div class="color-option orange" data-color="orange"></div>
            </div>
          </div>
          <div class="field">
            <label>Live Preview</label>
            <div class="subcat-preview-card">
              <div class="subcat-icon-wrap red" id="scPreviewIcon"></div>
              <div class="subcat-preview-info">
                <div class="subcat-preview-name" id="scPreviewName">TOURNAMENT</div>
                <div class="subcat-preview-desc" id="scPreviewDesc">Tournament configs</div>
              </div>
            </div>
          </div>
          <div class="actions">
            <button id="scSaveBtn" class="btn primary" type="button">SAVE CATEGORY</button>
            <button id="scResetBtn" class="btn secondary" type="button">CLEAR</button>
          </div>
          <div id="scMsg" class="notice">Ready.</div>
          <div id="scList" class="subcat-list"></div>
        </section>

        <section class="card-panel">
          <h2 id="formTitle"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg> Create product</h2>
          <p class="sub">Product save হলে সাথে সাথে User Panel এ চলে যাবে।</p>
          <input id="editId" type="hidden">
          <div class="field">
            <label>Product name *</label>
            <input id="name" maxlength="100" placeholder="e.g. WHITE GUNSKIN LOCATION [FF MAX]">
          </div>
          <div class="two">
            <div class="field">
              <label>Category</label>
              <select id="category">
                <option value="Free">Free</option>
                <option value="Premium">Premium</option>
                <option value="Other">Other</option>
              </select>
            </div>
            <div class="field">
              <label>Status</label>
              <select id="status">
                <option value="active">Active</option>
                <option value="inactive">Disabled</option>
              </select>
            </div>
          </div>
          <div class="field" id="deliveryModeField" style="display:none">
            <label>Free Product System</label>
            <select id="deliveryMode">
              <option value="file">File System — app download</option>
              <option value="link">Link System — open in Chrome</option>
            </select>
            <div class="hint">Free প্রোডাক্টের জন্য বেছে নাও। Premium/Other আগের File System-এই থাকবে।</div>
          </div>
          <div class="field" id="subCatField" style="display:none">
            <label>Premium Category (optional)</label>
            <select id="subCategory">
              <option value="">-- Optional --</option>
            </select>
            <div class="hint">Optional। খালি রাখলে "Uncategorized" তে যাবে।</div>
          </div>
          <div class="field"><label>Image URL</label><input id="imageUrl" type="url" placeholder="https://example.com/image.png"></div>
          <div class="field"><label>Description (optional)</label><textarea id="description" maxlength="500" style="min-height:60px"></textarea></div>
          <div class="section-head">
            <span class="icon activate"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg></span>
            <span class="label">Activate</span>
          </div>
          <div class="field"><label id="downloadUrlLabel">Download URL *</label><input id="downloadUrl" type="url" placeholder="https://..."></div>
          <div id="fileSystemFields">
          <div class="two">
            <div class="field"><label>File name *</label><input id="fileName" maxlength="120" placeholder="config.zip"></div>
            <div class="field">
              <label>File type</label>
              <select id="fileType">
                <option value="auto">Auto detect</option>
                <option value="file">Regular file</option>
                <option value="zip">ZIP archive</option>
              </select>
            </div>
          </div>
          <div class="field"><label>Activate target path (full) *</label><input id="targetPath" maxlength="300" placeholder="Android/data/com.dts.freefiremax/files"></div>
          <div class="field" style="padding:13px;border:1px solid rgba(225,29,72,.28);border-radius:12px;background:rgba(225,29,72,.045)">
            <label for="backupEnabled" style="display:flex;align-items:flex-start;gap:10px;cursor:pointer;margin:0;text-transform:none;letter-spacing:0;font-size:13px">
              <input id="backupEnabled" type="checkbox" style="width:18px;height:18px;accent-color:#e11d48;flex-shrink:0;margin-top:2px">
              <span><strong>Backup Download (ON/OFF)</strong><span style="display:block;font-size:11px;font-weight:500;color:#999;margin-top:5px">ON: প্রথমবার ডাউনলোড করে অ্যাপের Private Backup Folder-এ রাখবে; পরেরবার সেখান থেকে কপি/Extract হবে। OFF: বর্তমান Direct Download পদ্ধতি চলবে।</span></span>
            </label>
          </div>
          </div>
          <div class="section-head">
            <span class="icon deactivate"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></span>
            <span class="label">Deactivate</span>
          </div>
          <div class="field"><label>Deactivate path (full) *</label><input id="deletePath" maxlength="300" placeholder="Android/data/com.dts.freefiremax/files"></div>
          <div class="field"><label>Delete names *</label><textarea id="deleteNames" placeholder="config.json&#10;profile"></textarea></div>
          <div class="actions">
            <button id="saveBtn" class="btn primary" type="button">SAVE PRODUCT</button>
            <button id="resetBtn" class="btn secondary" type="button">CLEAR FORM</button>
          </div>
          <div id="formMsg" class="notice">Fields marked * are required.</div>
        </section>
      </div>

      <div>
