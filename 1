function svgIcon(name, size){
  size = size || 24;
  var ic = SVG_ICONS[name] || SVG_ICONS.star;
  return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="'+size+'" height="'+size+'">' + ic.path + '</svg>';
}
function emojiToIconName(emoji){
  var map = {'🎮':'gamepad','🎯':'target','🎨':'palette','🔫':'weapon','⚔️':'sword','🔥':'fire','⚡':'lightning','💎':'diamond','👑':'crown','🏆':'trophy','🚀':'rocket','✨':'sparkle','🛡️':'shield','⭐':'star','💠':'gem','☠️':'skull','📦':'box','🏷️':'tag','💾':'chip','📍':'location'};
  return map[emoji] || 'star';
}

function $(id){ return document.getElementById(id); }
function message(id, text, type){
  var el = $(id); if (!el) return;
  el.textContent = text;
  el.className = "notice" + (type ? " " + type : "");
}
function makeLogFn(logId){
  return function(text, type){
    try {
      var log = $(logId); if (!log) return;
      var line = document.createElement("span");
      line.className = "line " + (type || "info");
      line.textContent = "[" + new Date().toLocaleTimeString() + "] " + text;
      log.appendChild(line);
      log.scrollTop = log.scrollHeight;
    } catch(e){}
  };
}
var logPush = makeLogFn("pushLog");
var logDel = makeLogFn("delLog");
function safeText(v){ return String(v == null ? "" : v); }
function validHttpsUrl(value, optional){
  if (!value && optional) return true;
  try { var u = new URL(value); return u.protocol === "https:"; }
  catch(e){ return false; }
}
function cleanFileName(v){
  var name = String(v || "").trim();
  if (!name) return "";
  if (name === "." || name === ".." || /[\/\\\0]/.test(name) || name.length > 120) throw new Error("File name invalid.");
  return name;
}
function cleanPath(v, fieldName){
  var p = String(v || "").trim().replace(/\\/g, "/");
  if (!p) throw new Error(fieldName + " is required.");
  if (p.length > 300 || /\0/.test(p)) throw new Error(fieldName + " is too long.");
  if (p.indexOf("..") >= 0) throw new Error(fieldName + " cannot contain '..'.");
  return p.replace(/\/+$/g, "");
}
function cleanDeleteNames(v){
  var lines = String(v || "").split(/\r?\n/);
  var out = [];
  for (var i = 0; i < lines.length; i++){
    var line = lines[i].trim();
    if (!line) continue;
    if (line === "." || line === ".." || line.indexOf("/") >= 0 || line.indexOf("\\") >= 0 || line.length > 120) throw new Error("Delete name invalid: " + line);
    out.push(line);
  }
  return out;
}
function dbRequest(path, method, body){
  return fetch(DB_URL + path + ".json", {
    method: method || "GET",
    headers: { "Content-Type": "application/json" },
    body: body === null || body === undefined ? undefined : JSON.stringify(body)
  }).then(function(r){
    return r.json().catch(function(){ return null; }).then(function(data){
      if (!r.ok) throw new Error((data && data.error) || ("DB request failed (" + r.status + ")"));
      if (data && typeof data === "object" && data.error) throw new Error(data.error);
      return data;
    });
  });
}
function fmtDate(ts){
  if (!ts) return "—";
  try {
    var d = new Date(ts);
    return d.toLocaleDateString("en-GB", { day: "2-digit", month: "short", year: "numeric" });
  } catch(e){ return "—"; }
}
function toDateInput(ts){
  if (!ts) return "";
  try {
    var d = new Date(ts);
    var yyyy = d.getFullYear();
    var mm = String(d.getMonth() + 1).padStart(2, "0");
    var dd = String(d.getDate()).padStart(2, "0");
    return yyyy + "-" + mm + "-" + dd;
  } catch(e){ return ""; }
}

function normalizeProduct(p, id){
  p = p || {};
  return {
    id: id,
    name: safeText(p.name || p.title || p.productName),
    category: safeText(p.category || p.type || "Other"),
    subCategory: safeText(p.subCategory || p.sub_category || ""),
    imageUrl: safeText(p.imageUrl || p.image || p.thumbnail),
    downloadUrl: safeText(p.downloadUrl || p.download_url || p.url || p.link),
    fileName: safeText(p.fileName || p.filename),
    fileType: safeText(p.fileType || "auto"),
    backupEnabled: p.backupEnabled === true || String(p.backupEnabled || p.backup_enabled || "false").toLowerCase() === "true",
    deliveryMode: p.category === "Free" && p.deliveryMode === "link" ? "link" : "file",
    targetPath: safeText(p.targetPath || p.target_path || p.destinationPath),
    deletePath: safeText(p.deletePath || p.delete_path || ""),
    deleteNames: safeText(p.deleteNames || p.delete_names || ""),
    description: safeText(p.description || p.details),
    isActive: (p.isActive !== undefined) ? !!p.isActive : (p.active !== undefined ? !!p.active : String(p.status || "active").toLowerCase() !== "inactive"),
    createdAt: p.createdAt || null
  };
}
function loadProducts(){
  var btn = $("refreshBtn"); if (btn) btn.disabled = true;
  dbRequest(PRODUCTS_PATH, "GET", null)
    .then(function(raw){
      currentProducts = {};
      if (raw && typeof raw === "object"){
        Object.keys(raw).forEach(function(id){ currentProducts[id] = normalizeProduct(raw[id], id); });
      }
      renderProducts(); updateStats();
    })
    .catch(function(e){ message("formMsg", "Could not load products: " + e.message, "err"); })
    .then(function(){ if (btn) btn.disabled = false; });
}
function updateStats(){
  var list = Object.keys(currentProducts).map(function(k){ return currentProducts[k]; });
  $("totalCount").textContent = list.length;
  $("activeCount").textContent = list.filter(function(p){ return p.isActive; }).length;
  $("freeCount").textContent = list.filter(function(p){ return p.category === "Free"; }).length;
  $("premiumCount").textContent = list.filter(function(p){ return p.category === "Premium"; }).length;
  $("otherCount").textContent = list.filter(function(p){ return p.category === "Other"; }).length;
}
function catPillClass(cat){
  if (cat === "Free") return "pill cat-free";
  if (cat === "Premium") return "pill cat-premium";
  return "pill cat-other";
}
function renderProducts(){
  var q = $("search").value.trim().toLowerCase();
  var list = Object.keys(currentProducts).map(function(k){ return currentProducts[k]; })
    .filter(function(p){
      if (currentCat !== "All" && p.category !== currentCat) return false;
      if (!q) return true;
      return (p.name + " " + p.category + " " + p.subCategory + " " + p.fileName + " " + p.targetPath).toLowerCase().indexOf(q) >= 0;
    });
  var root = $("products");
  root.innerHTML = "";
  if (!list.length){
    root.innerHTML = '<div class="notice">No products in this category yet.</div>';
    return;
  }
  list.sort(function(a,b){ return a.name.localeCompare(b.name); });
  list.forEach(function(p){
    var card = document.createElement("article");
    card.className = "product";
    var img;
    if (p.imageUrl && validHttpsUrl(p.imageUrl, true)){
      img = document.createElement("img");
      img.className = "thumb"; img.alt = ""; img.src = p.imageUrl;
      img.onerror = function(){ img.parentNode.removeChild(img); var blank = document.createElement("div"); blank.className = "thumb blank"; blank.innerHTML = svgIcon('box', 22); card.insertBefore(blank, card.firstChild); };
    } else {
      img = document.createElement("div");
      img.className = "thumb blank";
      img.innerHTML = svgIcon('box', 22);
    }
    var body = document.createElement("div");
    var head = document.createElement("div"); head.className = "phead";
    var title = document.createElement("div"); title.className = "pname"; title.textContent = p.name || "(Unnamed)";
    var pill = document.createElement("span");
    pill.className = p.isActive ? catPillClass(p.category) : "pill off";
    pill.textContent = p.isActive ? p.category.toUpperCase() : "DISABLED";
    head.appendChild(title); head.appendChild(pill);
    var meta = document.createElement("div"); meta.className = "meta";
    var deleteCount = p.deleteNames ? p.deleteNames.split("\n").filter(function(x){ return x.trim(); }).length : 0;
    var subcatLine = p.subCategory ? '<div>📂 Category: <b>' + p.subCategory + '</b></div>' : '';
    meta.innerHTML = '<div><b>' + p.category + '</b> · ' + (p.deliveryMode === 'link' ? 'LINK SYSTEM' : (p.fileName || 'no file')) + '</div>' + (p.deliveryMode === 'link' ? '<div>↗ OPEN LINK · ' + (p.downloadUrl || '') + '</div>' : '<div>Backup: <b>' + (p.backupEnabled ? 'ON' : 'OFF · Direct Download') + '</b></div>' + subcatLine + '<div><span class="tag-a">▼ ACTIVATE</span> → ' + (p.targetPath || 'no target') + '</div>' + '<div><span class="tag-d">✕ DEACTIVATE</span> → ' + (p.deletePath || 'no path') + ' · ' + deleteCount + ' name(s)</div>');
    var actions = document.createElement("div"); actions.className = "pactions";
    var edit = document.createElement("button");
    edit.className = "btn secondary small"; edit.type = "button"; edit.textContent = "EDIT";
    edit.onclick = function(){ fillForm(p); };
    var toggle = document.createElement("button");
    toggle.className = "btn secondary small"; toggle.type = "button";
    toggle.textContent = p.isActive ? "DISABLE" : "ACTIVATE";
    toggle.onclick = function(){ toggleProduct(p); };
    var del = document.createElement("button");
    del.className = "btn danger small"; del.type = "button"; del.textContent = "DELETE";
    del.onclick = function(){ deleteProduct(p); };
    actions.appendChild(edit); actions.appendChild(toggle); actions.appendChild(del);
    body.appendChild(head); body.appendChild(meta); body.appendChild(actions);
    card.appendChild(img); card.appendChild(body);
    root.appendChild(card);
  });
}

function scrollToForm(formId) {
  var el = document.getElementById(formId);
  if (el) {
    el.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }
}

function fillForm(p){
  $("editId").value = p.id;
  $("formTitle").innerHTML = svgIcon('check', 18) + ' Edit product';
  $("name").value = p.name;
  var cat = ["Free","Premium","Other"].indexOf(p.category) >= 0 ? p.category : "Other";
  $("category").value = cat;
  $("deliveryMode").value = cat === "Free" && p.deliveryMode === "link" ? "link" : "file";
  $("status").value = p.isActive ? "active" : "inactive";
  $("imageUrl").value = p.imageUrl;
  $("downloadUrl").value = p.downloadUrl;
  $("fileName").value = p.fileName;
  $("fileType").value = ["auto","file","zip"].indexOf(p.fileType) >= 0 ? p.fileType : "auto";
  $("backupEnabled").checked = !!p.backupEnabled;
  updateDeliveryModeVisibility();
  $("targetPath").value = p.targetPath;
  $("deletePath").value = p.deletePath;
  $("deleteNames").value = p.deleteNames;
  $("description").value = p.description;
  renderSubcatDropdown(p.subCategory || "");
  updateSubcatVisibility(p.subCategory || "");
  message("formMsg", "Editing: " + p.name);
  setTimeout(function(){ scrollToForm("formTitle"); }, 100); 
}
function clearForm(){
  $("editId").value = "";
  $("formTitle").innerHTML = svgIcon('check', 18) + ' Create product';
  ["name","imageUrl","downloadUrl","fileName","targetPath","deletePath","deleteNames","description"].forEach(function(id){ $(id).value = ""; });
  $("category").value = "Free";
  $("deliveryMode").value = "file";
  updateDeliveryModeVisibility();
  $("status").value = "active";
  $("fileType").value = "auto";
  $("backupEnabled").checked = false;
  $("subCategory").value = "";
  updateSubcatVisibility();
  message("formMsg", "Form cleared.");
}
function updateDeliveryModeVisibility(){
  var cat = $("category").value;
  var modeField = $("deliveryModeField");
  if (modeField) modeField.style.display = cat === "Free" ? "block" : "none";
  if (cat !== "Free") $("deliveryMode").value = "file";
  var linkMode = cat === "Free" && $("deliveryMode").value === "link";
  var fileFields = $("fileSystemFields");
  if (fileFields) fileFields.style.display = linkMode ? "none" : "block";
  var urlLabel = $("downloadUrlLabel");
  var urlInput = $("downloadUrl");
  if (urlInput) urlInput.placeholder = linkMode ? "https://link-to-open-in-chrome..." : "https://...";
  if (urlLabel) urlLabel.textContent = linkMode ? "Open Link URL *" : "Download URL *";
}
function updateSubcatVisibility(forceValue){
  var cat = $("category").value;
  updateDeliveryModeVisibility();
  if (cat === "Premium"){
    $("subCatField").style.display = "block";
    renderSubcatDropdown(forceValue !== undefined ? forceValue : $("subCategory").value);
  } else {
    $("subCatField").style.display = "none";
    $("subCategory").value = "";
  }
}
function productPayload(){
  var name = $("name").value.trim();
  var downloadUrl = $("downloadUrl").value.trim();
  var imageUrl = $("imageUrl").value.trim();
  if (!name) throw new Error("Product name is required.");
  if (!validHttpsUrl(downloadUrl)) throw new Error("URL must be HTTPS.");
  if (!validHttpsUrl(imageUrl, true)) throw new Error("Image URL must be HTTPS.");
  var cat = $("category").value;
  var deliveryMode = cat === "Free" && $("deliveryMode").value === "link" ? "link" : "file";
  var fileName = "", targetPath = "", deletePath = "", deleteNamesArr = [];
  if (deliveryMode === "file") {
    fileName = cleanFileName($("fileName").value);
    if (!fileName) throw new Error("File name is required.");
    targetPath = cleanPath($("targetPath").value, "Activate target path");
    deletePath = cleanPath($("deletePath").value, "Deactivate path");
    deleteNamesArr = cleanDeleteNames($("deleteNames").value);
    if (!deleteNamesArr.length) throw new Error("At least one delete name.");
  }
  var isActive = $("status").value === "active";
  var subCat = cat === "Premium" ? $("subCategory").value : "";
  return {
    name: name, title: name, category: cat, subCategory: subCat,
    deliveryMode: deliveryMode, imageUrl: imageUrl, downloadUrl: downloadUrl,
    fileName: fileName, fileType: $("fileType").value,
    backupEnabled: deliveryMode === "file" && $("backupEnabled").checked,
    archive: $("fileType").value === "zip",
    targetPath: targetPath, deletePath: deletePath,
    deleteNames: deleteNamesArr.join("\n"),
    description: $("description").value.trim(),
    isActive: isActive, active: isActive,
    status: isActive ? "active" : "inactive",
    updatedAt: Date.now()
  };
}
function saveProduct(){
  var btn = $("saveBtn"); btn.disabled = true;
  var payload;
  try { payload = productPayload(); }
  catch(e){ message("formMsg", e.message, "err"); btn.disabled = false; return; }
  var id = $("editId").value;
  var promise;
  if (id) promise = dbRequest(PRODUCTS_PATH + "/" + encodeURIComponent(id), "PATCH", payload);
  else { payload.createdAt = Date.now(); promise = dbRequest(PRODUCTS_PATH, "POST", payload); }
  promise.then(function(){ message("formMsg", id ? "Product updated." : "Product created.", "ok"); clearForm(); loadProducts(); })
    .catch(function(e){ message("formMsg", e.message, "err"); })
    .then(function(){ btn.disabled = false; });
}
function toggleProduct(p){
  var active = !p.isActive;
  dbRequest(PRODUCTS_PATH + "/" + encodeURIComponent(p.id), "PATCH", { isActive: active, active: active, status: active ? "active" : "inactive", updatedAt: Date.now() })
    .then(function(){ loadProducts(); })
    .catch(function(e){ message("formMsg", "Status update failed: " + e.message, "err"); });
}
function deleteProduct(p){
  dbRequest(PRODUCTS_PATH + "/" + encodeURIComponent(p.id), "DELETE", null)
    .then(function(){ message("formMsg", "Product deleted.", "ok"); loadProducts(); })
    .catch(function(e){ message("formMsg", "Delete failed: " + e.message, "err"); });
}

function loadSubcats(){
  dbRequest(SUBCATS_PATH, "GET", null)
    .then(function(raw){
      currentSubcats = (raw && typeof raw === "object") ? raw : {};
      renderSubcats(); renderPuCatChecklist();
      if ($("category").value === "Premium") renderSubcatDropdown($("subCategory").value);
    })
    .catch(function(e){ currentSubcats = {}; renderSubcats(); renderPuCatChecklist(); });
}
function renderSubcats(){
  var root = $("scList");
  if (!root) return;
  root.innerHTML = "";
  var ids = Object.keys(currentSubcats || {});
  if (!ids.length){
    var emptyDiv = document.createElement("div");
    emptyDiv.className = "notice";
    emptyDiv.textContent = "No premium categories yet. Add one above.";
    root.appendChild(emptyDiv);
    return;
  }
  ids.sort(function(a,b){ return ((currentSubcats[a]||{}).order || 0) - ((currentSubcats[b]||{}).order || 0); });
  ids.forEach(function(id){
    var sc = currentSubcats[id] || {};
    var row = document.createElement("div");
    row.className = "subcat-row";
    var iconWrap = document.createElement("div");
    iconWrap.className = "subcat-icon-wrap " + (sc.color || "red");
    if (sc.iconType === "image" && sc.imageUrl){
      var img = document.createElement("img");
      img.src = sc.imageUrl; img.alt = "";
      img.onerror = function(){ iconWrap.innerHTML = svgIcon(sc.iconName || 'box', 28); };
      iconWrap.appendChild(img);
    } else {
      iconWrap.innerHTML = svgIcon(sc.iconName || 'star', 28);
    }
    var info = document.createElement("div"); info.className = "subcat-preview-info";
    var nm = document.createElement("div"); nm.className = "subcat-preview-name"; nm.textContent = sc.name || "(unnamed)";
