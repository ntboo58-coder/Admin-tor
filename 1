function statusBadgeText(u){
  if (u && u.banned) return { cls: "status-badge ban", txt: "BANNED" };
  var now = Date.now();
  var licenseMap = getUserCategoryLicenses(u);
  var keys = Object.keys(licenseMap || {});
  var activeN = 0, expiredN = 0, soonest = 0;
  keys.forEach(function(k){
    var l = licenseMap[k] || {};
    if (!l.category) return;
    var exp = Number(l.expiresAt) || 0;
    if (l.active === false || !exp || exp <= now){ expiredN++; }
    else {
      activeN++;
      if (!soonest || exp < soonest) soonest = exp;
    }
  });
  if (activeN === 0 && expiredN === 0){
    var exp = u && u.expiresAt ? Number(u.expiresAt) : 0;
    if (!exp) return { cls: "status-badge exp", txt: "NO DATE" };
    if (exp <= now) return { cls: "status-badge exp", txt: "EXPIRED" };
    var days0 = Math.floor((exp - now) / 86400000);
    if (days0 <= 7) return { cls: "status-badge warn", txt: days0 + "d LEFT" };
    return { cls: "status-badge active", txt: days0 + "d LEFT" };
  }
  if (activeN === 0) return { cls: "status-badge exp", txt: "ALL EXPIRED" };
  if (expiredN > 0) return { cls: "status-badge warn", txt: activeN + " ON · " + expiredN + " EXP" };
  var days = Math.floor((soonest - now) / 86400000);
  if (days <= 7) return { cls: "status-badge warn", txt: days + "d LEFT" };
  return { cls: "status-badge active", txt: days + "d LEFT" };
}
