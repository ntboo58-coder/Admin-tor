window.savePremiumEdit = function savePremiumEdit() {
  var id = editingPuId;
  if (!id) return;
  
  var newName = document.getElementById('editPuName').value.trim();
  var newPhone = document.getElementById('editPuPhone').value.trim();
  if (!newName) { alert("Name required!"); return; }
  
  var selectedCats = [];
  var chks = document.querySelectorAll('#editPuCatList input[type=checkbox]');
  for (var i=0;i<chks.length;i++) {
    if (chks[i].checked) selectedCats.push(chks[i].value);
  }
  
  if (!selectedCats.length) { alert("Select at least one category!"); return; }
  
  var existingLicenses = getUserCategoryLicenses(currentPremiumUsers[id] || {});
  var newLicenses = {};
  var now = Date.now();
  var latestExpiry = 0;
  
  for (var c=0;c<selectedCats.length;c++) {
    var cat = selectedCats[c];
    var expInp = document.getElementById("modal-exp-" + cat.replace(/[^a-zA-Z0-9]/g, "_"));
    var expVal = expInp ? expInp.value.trim() : "";
    
    // Parse expiry
    var expiresAt = 0;
    // Check if it's already a date (has year)
    if (/\d{4}/.test(expVal)) {
      var parsed = new Date(expVal);
      if (!isNaN(parsed.getTime())) expiresAt = parsed.getTime();
    }
    if (!expiresAt) {
      expiresAt = parseCustomExpiry(expVal);
    }
    if (!expiresAt) {
      alert("Invalid expiry format for: " + cat + " (e.g. 5, 5m)");
      return;
    }
    
    newLicenses[categoryKey(cat)] = { category: cat, expiresAt: expiresAt, active: true, updatedAt: now };
    if (expiresAt > latestExpiry) latestExpiry = expiresAt;
  }
  
  var payload = {
    name: newName,
    phone: newPhone,
    categories: selectedCats,
    categoryLicenses: newLicenses,
    expiresAt: latestExpiry,
    updatedAt: now
  };
  
  dbRequest(PREMIUM_USERS_PATH + "/" + encodeURIComponent(id), "PATCH", payload)
    .then(function() {
      message("puMsg", "User updated successfully!", "ok");
      closePremiumEditModal();
      loadPremiumUsers();
    })
    .catch(function(e) {
      alert("Update failed: " + e.message);
    });
}
