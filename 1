function savePremiumUser(){
  var btn = $("puSaveBtn"); btn.disabled = true;
  try {
    var editId = $("puEditId").value;
    var deviceId = (editId || $("puDeviceId").value).trim();
    var name = $("puName").value.trim();
    var phone = $("puPhone").value.trim();
    var cats = getSelectedPuCats();
    var expiryValues = getPuExpiryValues();
    if (!deviceId) throw new Error("Device ID required.");
    if (!name) throw new Error("Name required.");
    if (!cats.length) throw new Error("At least one category required.");
    var existing = currentPremiumUsers[deviceId] || {};
    var licenses = getUserCategoryLicenses(existing);
    var now = Date.now();
    
    cats.forEach(function(cat){
      var expiryStr = expiryValues[cat];
      if (!expiryStr) throw new Error("Expiry value required for: " + cat);
      
      var expiresAt = parseCustomExpiry(expiryStr);
      if (!expiresAt) throw new Error("Invalid expiry format for: " + cat + " (e.g. 5, 5m, 2h, 1y)");
      
      licenses[categoryKey(cat)] = { category:cat, expiresAt:expiresAt, active:true, updatedAt:now };
    });
    var allCats = Object.keys(licenses).map(function(k){ return licenses[k] && licenses[k].category; }).filter(function(v,i,arr){ return !!v && arr.indexOf(v) === i; });
    var latestExpiry = Object.keys(licenses).reduce(function(mx,k){ return Math.max(mx, Number((licenses[k]||{}).expiresAt)||0); },0);
    var payload = { name:name, phone:phone, deviceId:deviceId, expiresAt:latestExpiry, banned:existing.banned === true, categories:allCats, categoryLicenses:licenses, updatedAt:now };
    if (!editId && !existing.createdAt) payload.createdAt = Date.now();
    dbRequest(PREMIUM_USERS_PATH + "/" + encodeURIComponent(deviceId), "PATCH", payload)
      .then(function(){ message("puMsg", editId ? "User updated." : "User added.", "ok"); resetPuForm(); loadPremiumUsers(); })
      .catch(function(e){ message("puMsg", e.message, "err"); })
      .then(function(){ btn.disabled = false; });
  } catch(e){ message("puMsg", e.message, "err"); btn.disabled = false; }
}
function extendUser(id, u, days){
  var licenses = getUserCategoryLicenses(u), now = Date.now();
  Object.keys(licenses).forEach(function(k){ var l=licenses[k]||{}; var base=(l.expiresAt && l.expiresAt>now)?l.expiresAt:now; l.expiresAt=base+days*86400000; l.active=true; l.updatedAt=now; licenses[k]=l; });
  var latest = Object.keys(licenses).reduce(function(mx,k){ return Math.max(mx, Number((licenses[k]||{}).expiresAt)||0); },0);
  dbRequest(PREMIUM_USERS_PATH + "/" + encodeURIComponent(id), "PATCH", { categoryLicenses:licenses, expiresAt:latest, updatedAt:now })
    .then(function(){ message("puMsg", "+" + days + "d added to each category license.", "ok"); loadPremiumUsers(); })
    .catch(function(e){ message("puMsg", e.message, "err"); });
}
