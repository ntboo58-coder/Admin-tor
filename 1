function expireNow(id, u){
  if (!window.confirm("Expire all category licenses for this Device ID now?")) return;
  var licenses=getUserCategoryLicenses(u), now=Date.now()-1000;
  Object.keys(licenses).forEach(function(k){ licenses[k].expiresAt=now; licenses[k].active=false; licenses[k].updatedAt=Date.now(); });
