function categoryKey(name){ return String(name || "").replace(/[.#$\[\]\/]/g, "_"); }
function getUserCategoryLicenses(u){
  var out = (u && u.categoryLicenses && typeof u.categoryLicenses === "object") ? Object.assign({}, u.categoryLicenses) : {};
  (u && Array.isArray(u.categories) ? u.categories : []).forEach(function(cat){
    var key = categoryKey(cat); if (!out[key] && u.expiresAt) out[key] = { category:cat, expiresAt:u.expiresAt, active:true, migrated:true };
  });
  return out;
}

/* 🔥 CUSTOM EXPIRY PARSER ADDED HERE 🔥 */
function parseCustomExpiry(str) {
  if (!str) return null;
  str = String(str).trim().toLowerCase();
  if (!str) return null;
  
  var numMatch = str.match(/^(\d+(?:\.\d+)?)\s*([mhdwys]?)$/i);
  if (!numMatch) return null; 
  
  var val = parseFloat(numMatch[1]);
  var unit = numMatch[2];
  
  if (isNaN(val) || val <= 0) return null;
  
  var ms = 0;
  if (unit === 'm') ms = val * 60 * 1000;
  else if (unit === 'h') ms = val * 60 * 60 * 1000;
  else if (unit === 'd' || unit === '') ms = val * 24 * 60 * 60 * 1000; // empty = day
  else if (unit === 'w') ms = val * 7 * 24 * 60 * 60 * 1000;
  else if (unit === 'y') ms = val * 365 * 24 * 60 * 60 * 1000;
  
  return Date.now() + ms;
}
